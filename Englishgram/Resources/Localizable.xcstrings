    "Не удалось открыть локальные данные. Перезапустите приложение. Ваш прогресс не будет перезаписан.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось открыть локальные данные. Перезапустите приложение. Ваш прогресс не будет перезаписан."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się otworzyć danych lokalnych. Uruchom ponownie aplikację. Twoje postępy nie zostaną nadpisane."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося відкрити локальні дані. Перезапустіть програму. Ваш прогрес не буде перезаписано."
          }
        }
      },
      "extractionState": "manual"
    },
