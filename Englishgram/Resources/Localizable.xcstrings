    "Английская грамматика — шаг за шагом. Учитесь, практикуйтесь и замечайте свой прогресс.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Английская грамматика — шаг за шагом. Учитесь, практикуйтесь и замечайте свой прогресс."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gramatyka języka angielskiego - krok po kroku. Ucz się, ćwicz i zauważaj swoje postępy."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Англійська граматика – крок за кроком. Навчайтеся, практикуйтеся та помічайте свій прогрес."
          }
        }
      },
      "extractionState": "manual"
    },
    "Базовая тренировка": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Базовая тренировка"
