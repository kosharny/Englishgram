        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш прогресс сохранён. Возвращайтесь завтра!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje postępy zostały zapisane. Wróć jutro!"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш прогрес збережено. Повертайтеся завтра!"
